{
  "Torrents.Search": {
    "tag": "Поиск",
    "summary": "Найти торренты",
    "description": "Результаты всех источников одним JSON. id — TMDB ID, year — строка; mediaType=tv включает поиск сериала, остальные значения идут как фильм. title использует query, если не задан; originalTitle приоритетнее englishTitle. genres и workId сейчас не участвуют в поиске. Торрент в примере вымышленный.",
    "responses": {
      "200": {
        "description": "Успешный ответ.",
        "type": "TorrentSearchResponse",
        "examples": {
          "example": {
            "summary": "Пример",
            "value": {
              "results": [
                {
                  "id": "0123456789abcdef0123456789abcdef01234567",
                  "title": "Fullmetal Alchemist Brotherhood S01 1080p",
                  "tracker": "ExampleTracker",
                  "sizeBytes": 2147483648,
                  "sizeLabel": null,
                  "seeders": 18,
                  "leechers": 2,
                  "publishDate": "2026-10-01T12:00:00Z",
                  "magnetUri": "magnet:?xt=urn:btih:0123456789abcdef0123456789abcdef01234567",
                  "link": "https://tracker.example.com/releases/1",
                  "tags": [
                    {
                      "kind": "quality",
                      "value": "1080p"
                    }
                  ],
                  "viewed": null,
                  "override": null
                }
              ]
            }
          }
        }
      }
    },
    "requestExamples": {
      "example": {
        "summary": "Пример",
        "value": {
          "query": "Fullmetal Alchemist Brotherhood",
          "mediaType": "tv",
          "id": 31911,
          "title": "Стальной алхимик: Братство",
          "originalTitle": "鋼の錬金術師 FULLMETAL ALCHEMIST",
          "englishTitle": "Fullmetal Alchemist: Brotherhood",
          "year": "2009",
          "forceSearch": false
        }
      }
    }
  },
  "Torrents.SearchStream": {
    "tag": "Поиск",
    "summary": "Получать результаты по мере готовности",
    "description": "application/x-ndjson: отдельный JSON на каждой строке. Непустые batch содержат source и results; done завершает выдачу. Читайте поток построчно, не вызывайте response.json() для всего тела. Клиентский разрыв отменяет запрос. После отправки заголовков ошибка может оборвать поток без done.",
    "responses": {
      "200": {
        "description": "Успешный ответ.",
        "type": "string",
        "examples": {
          "example": {
            "summary": "Пример",
            "value": "{\"type\":\"batch\",\"source\":\"ExampleTracker\",\"results\":[{\"id\":\"0123456789abcdef0123456789abcdef01234567\",\"title\":\"Fullmetal Alchemist Brotherhood S01 1080p\",\"tracker\":\"ExampleTracker\",\"sizeBytes\":2147483648,\"sizeLabel\":null,\"seeders\":18,\"leechers\":2,\"publishDate\":\"2026-10-01T12:00:00Z\",\"magnetUri\":\"magnet:?xt=urn:btih:0123456789abcdef0123456789abcdef01234567\",\"link\":\"https://tracker.example.com/releases/1\",\"tags\":[{\"kind\":\"quality\",\"value\":\"1080p\"}],\"viewed\":null,\"override\":null}]}\n{\"type\":\"done\",\"source\":null,\"results\":null}\n"
          }
        },
        "contentType": "application/x-ndjson",
        "headers": {
          "Cache-Control": "no-cache, no-store",
          "X-Accel-Buffering": "no — отключение буферизации прокси."
        }
      }
    },
    "requestExamples": {
      "example": {
        "summary": "Пример",
        "value": {
          "query": "Fullmetal Alchemist Brotherhood",
          "mediaType": "tv",
          "id": 31911,
          "title": "Стальной алхимик: Братство",
          "originalTitle": "鋼の錬金術師 FULLMETAL ALCHEMIST",
          "englishTitle": "Fullmetal Alchemist: Brotherhood",
          "year": "2009",
          "forceSearch": false
        }
      }
    }
  },
  "Continue.List": {
    "tag": "Продолжение просмотра",
    "summary": "Получить последние просмотры",
    "description": "До 8 записей за последние 90 дней.",
    "responses": {
      "200": {
        "description": "Успешный ответ.",
        "type": "TorrentContinueListResponse",
        "examples": {
          "example": {
            "summary": "Пример",
            "value": {
              "items": [
                {
                  "mediaType": "tv",
                  "tmdbId": 31911,
                  "title": "Стальной алхимик: Братство",
                  "fileIndex": "1",
                  "progressSeconds": 120,
                  "durationSeconds": 1440,
                  "posterSrc": null,
                  "backdropSrc": null,
                  "stillSrc": null,
                  "season": 1,
                  "episode": 1,
                  "audioName": null,
                  "infoHash": "0123456789abcdef0123456789abcdef01234567",
                  "stream": null,
                  "updatedAt": "2026-10-05T09:00:00+00:00"
                }
              ]
            }
          }
        }
      }
    }
  },
  "Continue.Get": {
    "tag": "Продолжение просмотра",
    "summary": "Получить позицию одного произведения",
    "description": "Ключ: mediaType + tmdbId. Отсутствующая запись даёт 204 без тела (стандартный MVC formatter для Ok(null)).",
    "responses": {
      "200": {
        "description": "Успешный ответ.",
        "type": "TorrentContinueCursor",
        "examples": {
          "example": {
            "summary": "Пример",
            "value": {
              "mediaType": "tv",
              "tmdbId": 31911,
              "title": "Стальной алхимик: Братство",
              "fileIndex": "1",
              "progressSeconds": 120,
              "durationSeconds": 1440,
              "posterSrc": null,
              "backdropSrc": null,
              "stillSrc": null,
              "season": 1,
              "episode": 1,
              "audioName": null,
              "infoHash": "0123456789abcdef0123456789abcdef01234567",
              "stream": null,
              "updatedAt": "2026-10-05T09:00:00+00:00"
            }
          }
        }
      },
      "204": {
        "description": "Запись отсутствует; тело пустое."
      }
    },
    "parameters": {
      "mediaType": {
        "description": "Тип TMDB, обычно tv или movie.",
        "example": "tv"
      },
      "tmdbId": {
        "description": "TMDB ID.",
        "example": 31911
      }
    }
  },
  "Continue.Upsert": {
    "tag": "Продолжение просмотра",
    "summary": "Сохранить позицию воспроизведения",
    "description": "tmdbId>0 и непустой fileIndex обязательны. progressSeconds/durationSeconds — секунды. Запись обновляется по mediaType + tmdbId. Данные общие для этого сервиса, user ID в контракте отсутствует.",
    "responses": {
      "200": {
        "description": "Успешный ответ.",
        "type": "ApiSuccess",
        "examples": {
          "example": {
            "summary": "Пример",
            "value": {
              "success": true
            }
          }
        }
      },
      "400": {
        "description": "Ошибка проверки входа: текст. Ошибки JSON/привязки параметров возвращают ValidationProblemDetails.",
        "type": "string",
        "contentType": "text/plain"
      }
    },
    "requestExamples": {
      "example": {
        "summary": "Пример",
        "value": {
          "mediaType": "tv",
          "tmdbId": 31911,
          "title": "Стальной алхимик: Братство",
          "fileIndex": "1",
          "progressSeconds": 120,
          "durationSeconds": 1440,
          "posterSrc": null,
          "backdropSrc": null,
          "stillSrc": null,
          "season": 1,
          "episode": 1,
          "audioName": null,
          "infoHash": "0123456789abcdef0123456789abcdef01234567",
          "stream": null,
          "updatedAt": "2026-10-05T09:00:00+00:00"
        }
      }
    }
  },
