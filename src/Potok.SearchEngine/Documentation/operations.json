  "Overrides.Get": {
    "tag": "Переопределения",
    "summary": "Получить карты сезонов и файлов",
    "description": "При отсутствии данных возвращает 200 с пустыми seasonMap и fileMap, не 404. Числовые сезоны — строковые ключи; \"_\" — файлы без сезона.",
    "responses": {
      "200": {
        "description": "Успешный ответ.",
        "type": "TorrentOverrideMap",
        "examples": {
          "example": {
            "summary": "Пример",
            "value": {
              "hash": "0123456789abcdef0123456789abcdef01234567",
              "seasonMap": {},
              "fileMap": {}
            }
          }
        }
      },
      "400": {
        "description": "Ошибка проверки входа: текст. Ошибки JSON/привязки параметров возвращают ValidationProblemDetails.",
        "type": "string",
        "contentType": "text/plain"
      }
    },
    "parameters": {
      "hash": {
        "description": "Ключ торрента, обычно 40 символов infohash; приводится к нижнему регистру. Формат 40 hex проверяется лишь при добавлении сводки к результатам поиска.",
        "example": "0123456789abcdef0123456789abcdef01234567"
      }
    }
  },
  "Overrides.UpsertSeason": {
    "tag": "Переопределения",
    "summary": "Задать сопоставление сезона",
    "description": "sourceSeason=null соответствует ключу \"_\". targetSeason — целевой сезон, offset прибавляется к распознанному номеру эпизода. Возвращает обновлённую карту всех сезонов.",
    "responses": {
      "200": {
        "description": "Успешный ответ.",
        "type": "SeasonOverrideResult",
        "examples": {
          "example": {
            "summary": "Пример",
            "value": {
              "success": true,
              "seasonMap": {
                "_": {
                  "season": 1,
                  "offset": 0
                }
              }
            }
          }
        }
      },
      "400": {
        "description": "Ошибка проверки входа: текст. Ошибки JSON/привязки параметров возвращают ValidationProblemDetails.",
        "type": "string",
        "contentType": "text/plain"
      }
    },
    "requestExamples": {
      "example": {
        "summary": "Пример",
        "value": {
          "sourceSeason": null,
          "targetSeason": 1,
          "offset": 0
        }
      }
    },
    "parameters": {
      "hash": {
        "description": "Ключ торрента, обычно 40 символов infohash; приводится к нижнему регистру. Формат 40 hex проверяется лишь при добавлении сводки к результатам поиска.",
        "example": "0123456789abcdef0123456789abcdef01234567"
      }
    }
  },
  "Overrides.RemoveSeason": {
    "tag": "Переопределения",
    "summary": "Удалить сопоставление сезона",
    "description": "sourceSeason передаётся в query, не JSON. Без параметра удаляется ключ \"_\".",
    "responses": {
      "200": {
        "description": "Успешный ответ.",
        "type": "SeasonOverrideResult",
        "examples": {
