      }
    }
  },
  "Overrides.UpsertFile": {
    "tag": "Переопределения",
    "summary": "Задать сопоставление файла",
    "description": "Предпочтительно armTarget с непустыми workId/entryId/episodeId из Gateway АРМ. Legacy: season и episode>=0. mode=pin привязывает один файл; anchor задаёт начало последовательности. scopeFileIds допустим только для anchor: 1–2000 уникальных непустых ID, включая fileId. API сохраняет карту; применение переопределений выполняет клиент/плагин. Принадлежность IDs графу здесь не проверяется.",
    "responses": {
      "200": {
        "description": "Успешный ответ.",
        "type": "FileOverrideResult",
        "examples": {
          "example": {
            "summary": "Пример",
            "value": {
              "success": true,
              "fileMap": {
                "1": {
                  "season": null,
                  "episode": null,
                  "mode": "pin",
                  "armTarget": {
                    "workId": "1341b41c-2b09-4745-8413-611a6393fcf5",
                    "entryId": "c5b72b5a-ff16-5618-a294-25a146954916",
                    "episodeId": "1d5695ec-d28c-5f50-804c-1c67fc784783"
                  },
                  "scopeFileIds": null
                }
              }
            }
          }
        }
      },
      "400": {
        "description": "Ошибка проверки входа: текст. Ошибки JSON/привязки параметров возвращают ValidationProblemDetails.",
        "type": "string",
        "contentType": "text/plain"
      }
    },
    "requestExamples": {
      "example": {
        "summary": "Пример",
        "value": {
          "fileId": "1",
          "mode": "pin",
          "armTarget": {
            "workId": "1341b41c-2b09-4745-8413-611a6393fcf5",
            "entryId": "c5b72b5a-ff16-5618-a294-25a146954916",
            "episodeId": "1d5695ec-d28c-5f50-804c-1c67fc784783"
          }
        }
      },
      "anchor": {
        "summary": "Якорь для выбранных файлов; реальные IDs из снимка АРМ",
        "value": {
          "fileId": "1",
          "mode": "anchor",
          "armTarget": {
            "workId": "1341b41c-2b09-4745-8413-611a6393fcf5",
            "entryId": "c5b72b5a-ff16-5618-a294-25a146954916",
            "episodeId": "1d5695ec-d28c-5f50-804c-1c67fc784783"
          },
          "scopeFileIds": [
            "1",
            "2",
            "3"
          ]
        }
      },
      "legacy": {
        "summary": "Старое числовое сопоставление",
        "value": {
          "fileId": "1",
          "season": 1,
          "episode": 1,
          "mode": "pin"
        }
      }
    },
    "parameters": {
      "hash": {
        "description": "Ключ торрента, обычно 40 символов infohash; приводится к нижнему регистру. Формат 40 hex проверяется лишь при добавлении сводки к результатам поиска.",
        "example": "0123456789abcdef0123456789abcdef01234567"
      }
    }
  },
